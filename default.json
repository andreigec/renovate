{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [":timezone(Australia/Melbourne)", ":dependencyDashboard", ":rebaseStalePrs"],
  "packageRules": [
    {
      "description": "ag, renovate and e7npm tooling: Monday",
      "matchRepositories": [
        "andreigec/ag-*",
        "andreigec/renovate",
        "andreigec/eslint-config-e7npm"
      ],
      "schedule": "before 7am on monday"
    },
    {
      "description": "Analytica and Survey Foundry: Wednesday",
      "matchRepositories": [
        "andreigecanalytica/analytica.click",
        "andreigecanalytica/analytica.click.gh",
        "andreigecanalytica/surveyfoundry.com"
      ],
      "schedule": "before 7am on wednesday"
    },
    {
      "description": "Group all third party updates into a single automerged PR",
      "groupName": "all",
      "matchPackageNames": ["*"],
      "automerge": true
    },
    {
      "description": "Keep in-house package updates in their own automerged PR",
      "groupName": "in house",
      "matchPackageNames": ["ag-*", "analytica.click*", "eslint-config-e7npm", "surveyfoundry.com"],
      "automerge": true
    },
    {
      "description": "pnpm 11.28.8 and 11.28.9 segfault on the 16K-page arm64 CI runners (rpi0); 12.x works. Re-test newer 11.x before widening.",
      "matchPackageNames": ["pnpm"],
      "allowedVersions": "<11.28.8 || >=12"
    }
  ],
  "postUpdateOptions": ["pnpmDedupe"],
  "prConcurrentLimit": 2,
  "prNotPendingHours": 1,
  "updateNotScheduled": false,
  "minimumReleaseAge": "3 days",
  "semanticCommitType": "deps",
  "schedule": "before 7am on friday",
  "platformAutomerge": false,
  "automergeType": "pr",
  "rangeStrategy": "pin",
  "assignees": ["andreigec"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "minimumReleaseAge": null,
    "schedule": "before 7am on sunday"
  }
}
